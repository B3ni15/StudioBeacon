{
  "name": "studio-beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @beacon/desktop dev",
    "build": "pnpm build:plugin && pnpm --filter @beacon/desktop build",
    "build:plugin": "pnpm --filter @beacon/plugin build",
    "dist": "pnpm build:plugin && pnpm --filter @beacon/desktop dist",
    "typecheck": "pnpm -r --if-present run typecheck",
    "icons": "node apps/desktop/scripts/make-icons.mjs",
    "discord-assets": "node apps/desktop/scripts/make-discord-assets.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
